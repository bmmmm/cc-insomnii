#!/bin/bash
# cc-insomnii — bedtime shame statusline for Claude Code
# Reads JSON from stdin (CC statusline payload), outputs one styled line.
# No claudii deps. Requires: jq, bash 3.2+.

set -euo pipefail

# Version — keep in sync with man/man1/cc-insomnii.1 (.TH) and CHANGELOG.md.
_VERSION="0.3.0"

# --- Guard: jq required ---
if ! command -v jq >/dev/null 2>&1; then
  printf 'cc-insomnii: jq required\n' >&2; exit 1
fi

# --- Color constants (ANSI) ---
RST=$'\033[0m'
DIM=$'\033[2m'
BOLD=$'\033[1m'
BLINK=$'\033[5m'
BLINK2=$'\033[6m'
REVERSE=$'\033[7m'
UNDERLINE=$'\033[4m'
CYAN=$'\033[0;36m'
WHITE=$'\033[0;97m'

# --- Resolve CC_INSOMNII_HOME (repo root = one level above this script) ---
# Follow symlinks so a `ln -s /opt/cc-insomnii/bin/cc-insomnii /usr/local/bin/cc-insomnii`
# install still finds the shipped config/ next to the real binary, not next to
# the symlink. macOS bash 3.2 has no `readlink -f`, so we walk the chain by hand.
if [[ -z "${CC_INSOMNII_HOME:-}" ]]; then
  _self="${BASH_SOURCE[0]:-$0}"
  while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    if [[ "$_link" = /* ]]; then _self="$_link"
    else _self="$(cd "$(dirname "$_self")" && pwd)/$_link"; fi
  done
  _script_dir="$(cd "$(dirname "$_self")" && pwd)"
  CC_INSOMNII_HOME="$(dirname "$_script_dir")"
fi

# --- Built-in config defaults ---
_cfg_bedtime="23:00"
_cfg_dawn="04:00"
_cfg_shame="true"
_cfg_motivation="true"
_cfg_rainbow="true"
_cfg_breathing="true"

# Robustness defaults (env-only: terminal-capability and accessibility settings
# live in the environment, not the project config). _cfg_color is tri-state:
# "" = auto, a falsy spelling = force no-color, anything else = force color on.
_cfg_color=""
_cfg_ascii="false"
_cfg_accessible="false"

# Session-data defaults (env-only; all OFF so the default render is unchanged).
# These surface fields from the Claude Code statusline payload: the model name,
# the context-window pressure, the session duration, and the dollar cost.
_cfg_model="false"
_cfg_context="false"
_cfg_duration="false"
_cfg_cost="false"
_cfg_cost_bump="5"        # dollars; a session at/above this bumps the shame tier

# --- Load shipped messages (merged into _msg_* vars below) ---
_messages_file="${CC_INSOMNII_HOME}/config/shame-messages.json"

# --- Layer 2: user config.json ---
_user_cfg="${CC_INSOMNII_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/cc-insomnii/config.json}"
if [[ -f "$_user_cfg" ]]; then
  # Read nested keys (.shame.enabled, not the literal flat key "shame.enabled").
  # Map null→"" explicitly instead of `// ""`: jq's `//` treats a literal `false`
  # as empty, so `// ""` would make a `false` toggle unreadable. An object-type
  # guard ("if type==object then .enabled else .") handles both {"enabled":false}
  # and scalar false/true without dropping a field and shifting the field-split below.
  # Split on US (0x1f), NOT tab — see note below.
  _v=$(jq -r '
    [
      (.bedtime // ""),
      (.dawn    // ""),
      (if (.shame|type)      == "object" then .shame.enabled      else .shame      end),
      (if (.motivation|type) == "object" then .motivation.enabled else .motivation end),
      (if (.rainbow|type)    == "object" then .rainbow.enabled    else .rainbow    end),
      (if (.breathing|type)  == "object" then .breathing.enabled  else .breathing  end)
    ] | map(if . == null then "" else tostring end) | join([31] | implode)
  ' "$_user_cfg" 2>/dev/null) || _v=""
  # Split on US (0x1f), NOT tab: tab is IFS-whitespace, so bash collapses runs of
  # it and trims leading ones — an empty bedtime/dawn would shift later fields and
  # land a toggle value in the wrong variable. US never appears in the values.
  IFS=$'\x1f' read -r _u1 _u2 _u3 _u4 _u5 _u6 <<< "$_v"
  [[ -n "$_u1" ]] && _cfg_bedtime="$_u1"
  [[ -n "$_u2" ]] && _cfg_dawn="$_u2"
  [[ -n "$_u3" ]] && _cfg_shame="$_u3"
  [[ -n "$_u4" ]] && _cfg_motivation="$_u4"
  [[ -n "$_u5" ]] && _cfg_rainbow="$_u5"
  [[ -n "$_u6" ]] && _cfg_breathing="$_u6"
fi

# --- Layer 3: user messages.json (override catalog) ---
_user_msgs="${XDG_CONFIG_HOME:-$HOME/.config}/cc-insomnii/messages.json"
[[ -f "$_user_msgs" ]] && _messages_file="$_user_msgs"

# --- Layer 4: env vars (highest priority) ---
[[ -n "${CC_INSOMNII_BEDTIME:-}"   ]] && _cfg_bedtime="$CC_INSOMNII_BEDTIME"
[[ -n "${CC_INSOMNII_DAWN:-}"      ]] && _cfg_dawn="$CC_INSOMNII_DAWN"
[[ -n "${CC_INSOMNII_SHAME:-}"     ]] && _cfg_shame="$CC_INSOMNII_SHAME"
[[ -n "${CC_INSOMNII_MOTIVATION:-}" ]] && _cfg_motivation="$CC_INSOMNII_MOTIVATION"
[[ -n "${CC_INSOMNII_RAINBOW:-}"   ]] && _cfg_rainbow="$CC_INSOMNII_RAINBOW"
[[ -n "${CC_INSOMNII_BREATHING:-}" ]] && _cfg_breathing="$CC_INSOMNII_BREATHING"
[[ -n "${CC_INSOMNII_MESSAGES:-}"  ]] && _messages_file="$CC_INSOMNII_MESSAGES"
[[ -n "${CC_INSOMNII_COLOR:-}"      ]] && _cfg_color="$CC_INSOMNII_COLOR"
[[ -n "${CC_INSOMNII_ASCII:-}"      ]] && _cfg_ascii="$CC_INSOMNII_ASCII"
[[ -n "${CC_INSOMNII_ACCESSIBLE:-}" ]] && _cfg_accessible="$CC_INSOMNII_ACCESSIBLE"
[[ -n "${CC_INSOMNII_MODEL:-}"      ]] && _cfg_model="$CC_INSOMNII_MODEL"
[[ -n "${CC_INSOMNII_CONTEXT:-}"    ]] && _cfg_context="$CC_INSOMNII_CONTEXT"
[[ -n "${CC_INSOMNII_DURATION:-}"   ]] && _cfg_duration="$CC_INSOMNII_DURATION"
[[ -n "${CC_INSOMNII_COST:-}"       ]] && _cfg_cost="$CC_INSOMNII_COST"
[[ -n "${CC_INSOMNII_COST_BUMP:-}"  ]] && _cfg_cost_bump="$CC_INSOMNII_COST_BUMP"

# --- Normalize falsy toggle scalars to the canonical "false" ---
# The render branches gate features with `!= "false"`, so only the literal string
# "false" disables them. Accept the common falsy spellings (0, no, off, disabled)
# — case-insensitive — so `CC_INSOMNII_SHAME=0` or a config `"shame": "off"` turns
# the feature off like `false` does. Anything else (true, 1, yes, …) is left
# untouched. bash 3.2 has no `${v,,}`, so lowercase via tr.
_normalize_toggle() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    0|no|off|false|disabled) printf 'false' ;;
    *)                       printf '%s' "$1" ;;
  esac
}
_cfg_shame=$(_normalize_toggle "$_cfg_shame")
_cfg_motivation=$(_normalize_toggle "$_cfg_motivation")
_cfg_rainbow=$(_normalize_toggle "$_cfg_rainbow")
_cfg_breathing=$(_normalize_toggle "$_cfg_breathing")
_cfg_ascii=$(_normalize_toggle "$_cfg_ascii")
_cfg_accessible=$(_normalize_toggle "$_cfg_accessible")
_cfg_model=$(_normalize_toggle "$_cfg_model")
_cfg_context=$(_normalize_toggle "$_cfg_context")
_cfg_duration=$(_normalize_toggle "$_cfg_duration")
_cfg_cost=$(_normalize_toggle "$_cfg_cost")
[[ "$_cfg_cost_bump" =~ ^[0-9]+$ ]] || _cfg_cost_bump="5"

# --- Robustness flags: color / glyph / animation suppression ---
# Accessible mode is the strongest: it implies no color, ASCII glyphs, and no
# animation, for a stable screen-reader-friendly line. NO_COLOR (any non-empty
# value, per the no-color.org convention) and CC_INSOMNII_COLOR=never|false|0|...
# suppress color; CC_INSOMNII_COLOR=always|force overrides NO_COLOR to keep color.
# TERM=dumb is treated as no-color. With all of these unset/auto and a real TERM,
# every flag is 0 and the default colored render is byte-identical.
_no_color=0
_no_anim=0
_ascii_on=0
_color_force=0
[[ "$_cfg_ascii" != "false" ]] && _ascii_on=1
case "$(printf '%s' "${_cfg_color:-}" | tr '[:upper:]' '[:lower:]')" in
  always|force|on|true|1|yes|enabled) _color_force=1 ;;
  0|no|off|false|disabled|never)       _no_color=1 ;;
esac
if (( ! _color_force )); then
  [[ -n "${NO_COLOR:-}" ]] && _no_color=1
  [[ "${TERM:-}" == "dumb" ]] && _no_color=1
fi
if [[ "$_cfg_accessible" != "false" ]]; then
  _no_color=1; _ascii_on=1; _no_anim=1
fi
if (( _no_color )); then
  # Blank every scalar SGR constant; the inline rainbow/_VFG/_VBG/_shame_fg
  # escapes are blanked at their build sites below, and rainbow is forced off so
  # the clock takes the plain (now bold-less) path. Decay is skipped at mode 5.
  RST=""; DIM=""; BOLD=""; BLINK=""; BLINK2=""; REVERSE=""; UNDERLINE=""; CYAN=""; WHITE=""
  _cfg_rainbow="false"
fi

# --- Validate bedtime/dawn (after all layers, before parsing) ---
# A value is valid iff it is HH:MM with hour<=23 and minute<=59. 00:00 is
# legitimate. Garbage (e.g. an unset config landing on "" → 00:00, or "25:99")
# must not silently corrupt the clock math: warn to stderr (stdout stays a clean
# statusline) and fall back to the built-in default.
_valid_hhmm() {
  local _t="$1"
  [[ "$_t" =~ ^([0-9]{1,2}):([0-9]{2})$ ]] || return 1
  (( 10#${BASH_REMATCH[1]} <= 23 && 10#${BASH_REMATCH[2]} <= 59 ))
}
if ! _valid_hhmm "$_cfg_bedtime"; then
  printf 'cc-insomnii: invalid bedtime %s (want HH:MM 00:00-23:59); using 23:00\n' "$_cfg_bedtime" >&2
  _cfg_bedtime="23:00"
fi
if ! _valid_hhmm "$_cfg_dawn"; then
  printf 'cc-insomnii: invalid dawn %s (want HH:MM 00:00-23:59); using 04:00\n' "$_cfg_dawn" >&2
  _cfg_dawn="04:00"
fi

# --- CLI args ---
# --after=CMD lets cc-insomnii sit ON TOP of an existing cc-statusline tool
# instead of replacing it. cc-insomnii reads stdin once, renders its own line
# FIRST (always the top line), then feeds the same JSON to CMD and prints
# CMD's output below. The user keeps every metric the original tool renders
# and gains the bedtime nudge as the prominent top line — no loss, no
# reorder, just cc-insomnii prepended.
WRAP_AFTER=""
for _arg in "$@"; do
  case "$_arg" in
    --after=*)
      [ -n "$WRAP_AFTER" ] && { printf 'cc-insomnii: --after specified more than once\n' >&2; exit 2; }
      WRAP_AFTER="${_arg#--after=}" ;;
    --help|-h)
      cat <<'HELP'
cc-insomnii — bedtime shame statusline for Claude Code.

USAGE
  cc-insomnii                Read JSON from stdin, render one styled status line.
  cc-insomnii --after=CMD    Render the cc-insomnii line FIRST (always the top
                             line), then feed the same JSON to CMD and print
                             CMD's output below. Use this when you already have
                             a richer statusLine and want cc-insomnii on top of it
                             (not replacing it).
  cc-insomnii --help         Show this help.
  cc-insomnii --version      Print the version and exit.

CONFIG
  Env: CC_INSOMNII_BEDTIME, CC_INSOMNII_DAWN, CC_INSOMNII_SHAME, CC_INSOMNII_MOTIVATION,
       CC_INSOMNII_RAINBOW, CC_INSOMNII_BREATHING, CC_INSOMNII_COLOR, CC_INSOMNII_ASCII,
       CC_INSOMNII_ACCESSIBLE, CC_INSOMNII_MODEL, CC_INSOMNII_CONTEXT,
       CC_INSOMNII_DURATION, CC_INSOMNII_COST, CC_INSOMNII_COST_BUMP,
       CC_INSOMNII_CONFIG, CC_INSOMNII_MESSAGES, CC_INSOMNII_HOME, CC_INSOMNII_NOW
  No-color: NO_COLOR / TERM=dumb / CC_INSOMNII_COLOR=never render without ANSI color.
       CC_INSOMNII_ACCESSIBLE=1 also drops glyphs-emoji and all animation.
  Session: CC_INSOMNII_MODEL/CONTEXT/DURATION/COST surface payload fields (model
       name, context redline, session duration, dollar cost). All OFF by default.
  File: $XDG_CONFIG_HOME/cc-insomnii/config.json (or ~/.config/cc-insomnii/config.json)
  Catalog override: $XDG_CONFIG_HOME/cc-insomnii/messages.json

PREVIEW
  CC_INSOMNII_NOW=HH:MM renders as if the clock read that time — preview any
  mode without waiting for it, e.g.:
      echo '{}' | CC_INSOMNII_NOW=02:00 CC_INSOMNII_BEDTIME=23:00 cc-insomnii

See cc-insomnii(1) for the full documentation.
HELP
      exit 0
      ;;
    --version|-V)
      printf 'cc-insomnii %s\n' "$_VERSION"
      exit 0
      ;;
    *)
      printf 'cc-insomnii: unknown argument: %s (try --help)\n' "$_arg" >&2
      exit 2
      ;;
  esac
done

# --- Read stdin (consumed once; reused below for --after composition) ---
_json=$(cat)

# --- Time math — one date call keeps every field on the same second ---
# CC_INSOMNII_NOW previews (or tests) any wall-clock time without waiting for it:
# set it to HH:MM and the whole render — mode selection, the dawn/motivation
# windows, the midnight-wrap delta — behaves as if the clock read that time. The
# epoch used for animation and message rotation is derived deterministically from
# HH:MM, so a given preview is reproducible. Unset (the normal path) reads the
# real clock with a single date call that keeps every field on the same second.
if [[ -n "${CC_INSOMNII_NOW:-}" ]]; then
  if [[ "$CC_INSOMNII_NOW" =~ ^([0-9]{1,2}):([0-9]{2})$ ]]; then
    _now_h=$(( 10#${BASH_REMATCH[1]} )); _now_m=$(( 10#${BASH_REMATCH[2]} ))
    if (( _now_h > 23 || _now_m > 59 )); then
      printf 'cc-insomnii: invalid CC_INSOMNII_NOW %s (want HH:MM, 00:00-23:59)\n' "$CC_INSOMNII_NOW" >&2
      exit 2
    fi
    _now_min=$(( _now_h * 60 + _now_m ))
    _hhmm=$(printf '%02d:%02d' "$_now_h" "$_now_m")
    _ts=$(( _now_min * 60 ))  # synthetic but stable epoch → reproducible preview
    # NOTE: _ts = _now_min*60, so the _ts/30 message-rotation index advances by 2
    # per previewed minute — a future test must not assume +1 minute = +1 message.
  else
    printf 'cc-insomnii: invalid CC_INSOMNII_NOW %s (want HH:MM, 00:00-23:59)\n' "$CC_INSOMNII_NOW" >&2
    exit 2
  fi
else
  IFS='|' read -r _ts _hhmm _now_h _now_m <<< "$(date '+%s|%H:%M|%H|%M')"
  _now_h="${_now_h#0}"; _now_m="${_now_m#0}"
  _now_min=$(( ${_now_h:-0} * 60 + ${_now_m:-0} ))
fi

# Parse bedtime and dawn into minutes-since-midnight
_parse_hhmm() {
  local _t="$1" _h _m
  if [[ "$_t" =~ ^([0-9]{1,2}):([0-9]{2})$ ]]; then
    _h="${BASH_REMATCH[1]#0}"; _m="${BASH_REMATCH[2]#0}"
    printf '%d' "$(( ${_h:-0} * 60 + ${_m:-0} ))"
  else
    printf '0'
  fi
}

_bt_min=$(_parse_hhmm "$_cfg_bedtime")
_dw_min=$(_parse_hhmm "$_cfg_dawn")

# Delta since bedtime — shortest signed distance on the 24h circle, in
# [-720, 720). Just before bedtime delta is small-negative (the mode-0
# approach); once bedtime passes it climbs through the shame modes. Taking the
# centered remainder (instead of the old "+1440 only if before 6am and bedtime
# is in the evening" wrap) makes the elapsed counter correct for an after-
# midnight bedtime too, without changing any evening/night (>= 18:00) render —
# there the centered value already equals the old wrap result inside the active
# window, and the night-window gate below suppresses it everywhere else.
_delta_min=$(( _now_min - _bt_min ))
if   (( _delta_min >=  720 )); then _delta_min=$(( _delta_min - 1440 ))
elif (( _delta_min <  -720 )); then _delta_min=$(( _delta_min + 1440 )); fi

# --- Sine approximation table for breathing pulse (32 steps, 0-100 scaled) ---
# Precomputed: round(50 + 50*sin(2*pi*i/32)) for i in 0..31
_SINE=(50 60 69 78 85 91 95 98 100 98 95 91 85 78 69 60 50 40 31 22 15 9 5 2 0 2 5 9 15 22 31 40)

# --- Glyph pools ---
# Shared night pool (modes 0-4)
_night_glyphs=("💤" "🌙" "🦉" "✨" "🌌" "😵" "🔥" "💀" "🫠" "👻" "🧠" "🛑" "⚠️" "🚨" "🌀" "🪦" "🧟" "🩸" "🌫️" "🌚" "🦴" "⏰" "🌛" "🛌" "🥱" "😴")

# Mode-5 doom set (heavy death/decay)
_doom_glyphs=("💀" "🪦" "🧟" "🩸" "🦴" "🌚" "😵" "🔥" "🛑" "🌀" "👁️" "⚰️" "🫀" "🫁" "🧠")

# Mode-0 sparkle glyph (no pool, single)
_sparkle_glyph="✦"

# Matrix-rain charset for drip animation
_drip_chars=("0" "1" "░" "▒" "▓" "█" "╳" "◢" "◣" "◤" "◥")

# Plain-mode and dawn glyphs (overridden by ASCII mode below)
_glyph_moon="☾"
_glyph_dawn="🌅"

# ASCII glyph fallback for emoji-incapable terminals and accessible mode. Swaps
# the emoji pools and the single moon/sparkle/dawn glyphs for 7-bit equivalents.
if (( _ascii_on )); then
  _night_glyphs=("zZ" "(" "o" "*" "~" "x_x" "!!" "+" "@" "o_o" "[~]" "(!)" "//" "z" "v" "_")
  _doom_glyphs=("X" "+" "#" "%" "*" "!!" "x_x" "@" "/!\\" "==" "X_X")
  _sparkle_glyph="*"
  _drip_chars=("0" "1" "." ":" "|" "#" "x" "/" "\\" "<" ">")
  _glyph_moon=")"
  _glyph_dawn="o/"
fi

# --- 24 color pairs for rainbow wave (fg;bg) — cycle every 3s ---
_vibe_pairs=(
  "219;53"  "51;17"   "226;88"  "201;54"
  "87;18"   "220;52"  "213;90"  "46;22"
  "99;57"   "196;52"  "45;18"   "214;88"
  "183;54"  "159;17"  "208;52"  "129;18"
  "171;54"  "39;17"   "203;52"  "118;22"
  "227;88"  "105;57"  "43;18"   "212;53"
)
_np=${#_vibe_pairs[@]}

# Rainbow palette (8 fg colors for wave)
_vibe_rpal=(
  $'\033[38;5;219m'
  $'\033[38;5;51m'
  $'\033[38;5;226m'
  $'\033[38;5;213m'
  $'\033[38;5;87m'
  $'\033[38;5;201m'
  $'\033[38;5;214m'
  $'\033[38;5;99m'
)

# --- Determine render mode ---
# Mode 0:  -30 ≤ delta < 0   (approaching bedtime, ≤30 min away)
# Mode 1:    0 ≤ delta < 60  (bedtime to +1h)
# Mode 2:   60 ≤ delta < 120 (+1h to +2h)
# Mode 3:  120 ≤ delta < 180 (+2h to +3h)
# Mode 4:  180 ≤ delta < 240 (+3h to +4h)
# Mode 5:  delta ≥ 240 OR past dawn window
# Morning: 07:00-15:59 (trumped by active shame)
# Dawn:    04:00-06:59 (when not in shame)
# Plain:   everything else

_render_mode="plain"

# Night window: from 30 min before bedtime until the 06:00 morning cutoff, on
# the 24h circle. The shame escalation and the mode-0 approach only fire inside
# it; outside, the night is over (or has not begun) and we fall through to the
# motivation/dawn/plain day modes. For an evening/night bedtime (>= 18:00) this
# window is exactly the region the old wrap covered, so those renders are
# unchanged; it only adds a morning bound so an after-midnight bedtime stops
# shaming at 06:00 instead of escalating to mode 5 for the rest of the day.
_morning_cut=360
_appr_start=$(( (_bt_min - 30 + 1440) % 1440 ))
if (( _appr_start < _morning_cut )); then
  if (( _now_min >= _appr_start && _now_min < _morning_cut )); then _in_night_window=1; else _in_night_window=0; fi
else
  if (( _now_min >= _appr_start || _now_min < _morning_cut )); then _in_night_window=1; else _in_night_window=0; fi
fi

# Shame takes priority — check first
if [[ "$_cfg_shame" != "false" ]] && (( _in_night_window && _delta_min >= 0 )); then
  if   (( _delta_min < 60  )); then _render_mode="mode1"
  elif (( _delta_min < 120 )); then _render_mode="mode2"
  elif (( _delta_min < 180 )); then _render_mode="mode3"
  elif (( _delta_min < 240 )); then _render_mode="mode4"
  else                              _render_mode="mode5"; fi
  # Past dawn also triggers mode5 (dawn-override: still awake after sunrise)
  if (( _dw_min > 0 && _now_min >= _dw_min && _now_min < 360 )); then
    _render_mode="mode5"
  fi
elif (( _in_night_window && _delta_min >= -30 && _delta_min < 0 )); then
  _render_mode="mode0"
elif [[ "$_cfg_motivation" != "false" ]] && (( _now_min >= 420 && _now_min < 960 )); then
  _render_mode="motivation"
elif (( _dw_min > 0 && _now_min >= _dw_min && _now_min < 420 && _dw_min < 420 )); then
  _render_mode="dawn"
fi

# --- Sanitize a catalog string for the one-line contract ---
# Strip C0 control bytes and ESC (so a malformed messages.json can't break the
# single-line output or inject its own SGR), and fold TAB/CR/LF to spaces. The
# delete range 000-010,013,014,016-037 intentionally leaves 011/012/015
# (TAB/LF/CR), which the second tr maps to spaces; 177 (DEL) is dropped too.
# LC_ALL=C makes tr byte-oriented so multibyte UTF-8 (e.g. the em-dash in the
# shipped catalog) passes through untouched — its bytes are all >127.
_sanitize() {
  printf '%s' "$1" | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177' | LC_ALL=C tr '\011\012\015' '   '
}

# --- Pick shame/motivation message from catalog ---
_pick_message() {
  local _mode_num="$1"  # integer 0-5 for shame, "motivation", "dawn"
  local _fallback="$2"
  local _result=""

  if [[ ! -f "$_messages_file" ]]; then
    printf '%s' "$_fallback"; return
  fi

  case "$_mode_num" in
    motivation)
      _result=$(jq -r --argjson ts "$_ts" '
        .motivation // [] | if (type=="array") and length > 0 then .[($ts / 30 | floor) % length] else empty end
      ' "$_messages_file" 2>/dev/null) || _result="" ;;
    dawn)
      _result=$(jq -r --argjson ts "$_ts" '
        .dawn // [] | if (type=="array") and length > 0 then .[($ts / 30 | floor) % length] else empty end
      ' "$_messages_file" 2>/dev/null) || _result="" ;;
    0)
      _result=$(jq -r --argjson ts "$_ts" '
        ( if (.shame|type)=="object" then .shame else {} end )
        | ((."0" // []) | if type=="array" then . else [] end)
        | if length > 0 then .[($ts / 30 | floor) % length] else empty end
      ' "$_messages_file" 2>/dev/null) || _result="" ;;
    *)
      # Accumulate messages from mode 1 up to and including this mode. Key "0" is
      # the pre-bedtime approach pool ("30 min until bedtime") — excluded here so
      # it can't surface once bedtime has already passed.
      _result=$(jq -r --argjson mode "$_mode_num" --argjson ts "$_ts" '
        ( if (.shame|type)=="object" then .shame else {} end )
        | [ to_entries | sort_by(.key|tonumber? // -1) | .[]
            | select((.key|tonumber? // -1) > 0 and (.key|tonumber? // -1) <= $mode)
            | .value | (if type=="array" then . else [] end) | .[]
            | select(type=="string") ] as $pool
        | if ($pool | length) > 0 then $pool[($ts / 30 | floor) % ($pool | length)] else empty end
      ' "$_messages_file" 2>/dev/null) || _result="" ;;
  esac

  [[ -z "$_result" || "$_result" == "null" ]] && _result="$_fallback"
  _result=$(_sanitize "$_result")
  printf '%s' "$_result"
}

# --- Build rainbow clock string ---
# _build_rainbow <text> <wave_speed> <rbase> <blink_esc> <vibe_mode>
_build_rainbow() {
  local _text="$1" _speed="$2" _rb="$3" _bl="$4" _vm="$5"
  local _n=${#_text} _wave _vi _dist _rc _out=""
  _wave=$(( (_ts * _speed) % _n ))
  for (( _vi=0; _vi<_n; _vi++ )); do
    _dist=$(( (_vi - _wave + _n) % _n ))
    _rc="${_vibe_rpal[$(( (_rb + _vi) % ${#_vibe_rpal[@]} ))]}"
    case $_dist in
      0) _out+="${BOLD}${_bl}${UNDERLINE}${_rc}${_text:$_vi:1}${RST}" ;;
      1) _out+="${BOLD}${UNDERLINE}${_rc}${_text:$_vi:1}${RST}" ;;
      2) _out+="${BOLD}${_rc}${_text:$_vi:1}${RST}" ;;
      3) _out+="${_rc}${_text:$_vi:1}${RST}" ;;
      *) _out+="${DIM}${_rc}${_text:$_vi:1}${RST}" ;;
    esac
  done
  printf '%s' "$_out"
}

# --- Char decay: replace ~30% of clock chars with █ at mode 4+ ---
# Uses _ts as seed so output is stable within one second.
_apply_decay() {
  local _text="$1" _out="" _i _ch _seed _hash
  _seed=$(( _ts % 997 ))  # prime mod for cheap pseudo-rand
  for (( _i=0; _i<${#_text}; _i++ )); do
    _ch="${_text:$_i:1}"
    # Skip spaces and colon — keep structure legible
    if [[ "$_ch" != " " && "$_ch" != ":" ]]; then
      # Deterministic per-char hash, decay when < 3 (≈30% of chars on average).
      # The index coefficient 3 is coprime to 10, so over any run of 10 consecutive
      # positions exactly 3 decay — which kills the real bug: the earlier
      # multiplicative form (seed*(i+1)*31 mod 10) collapsed to ALL-decay (an
      # unreadable all-█ clock) whenever seed was a multiple of 10, and the
      # additive form has no all-decay seed. A short whole-hour clock can still,
      # for some seeds, land entirely outside the decay band and show no decay for
      # that one second; that is harmless (the clock just stays legible briefly).
      # The seed shifts which positions decay each second so the glitch animates.
      _hash=$(( (_seed + _i * 3 + 7) % 10 ))
      (( _hash < 3 )) && _ch="█"
    fi
    _out+="$_ch"
  done
  printf '%s' "$_out"
}

# --- Matrix drip char (rotates based on time * 7) ---
_drip_char() {
  local _n=${#_drip_chars[@]}
  local _idx=$(( (_ts * 7) % _n ))
  printf '%s' "${_drip_chars[$_idx]}"
}

# --- Breathing color escape for a given 256-color base ---
_breath_phase=$(( (_ts * 4) % 32 ))  # full cycle every 8 seconds

# --- Session data from the statusline payload (one batched jq pass) ---
# Surfaces fields the script previously ignored: the model name (calm-mode
# badge), context-window pressure (clock redline), session duration (clock tag),
# and dollar cost (shame tier bump + tag). The jq call runs ONLY when at least
# one of those features is enabled, so the default render is both byte-identical
# and free of an extra jq invocation. Cost is read as integer cents — jq does the
# float, bash stays integer-only (no bc/awk). Split on US (0x1f), never tab.
_model_name=""; _cost_cents=0; _dur_ms=0; _ctx_pct=""; _ctx_exceeds=0
_session_on=0
[[ "$_cfg_model"    != "false" ]] && _session_on=1
[[ "$_cfg_context"  != "false" ]] && _session_on=1
[[ "$_cfg_duration" != "false" ]] && _session_on=1
[[ "$_cfg_cost"     != "false" ]] && _session_on=1
if (( _session_on )); then
  _session=$(printf '%s' "$_json" | jq -r '
    [ (.model.display_name // ""),
      (((.cost.total_cost_usd // 0) * 100) | floor),
      (.cost.total_duration_ms // 0),
      (if (.context_window.used_percentage | type) == "number"
         then (.context_window.used_percentage | floor) else "" end),
      (if .exceeds_200k_tokens == true then "1" else "0" end)
    ] | map(tostring) | join([31] | implode)
  ' 2>/dev/null) || _session=""
  IFS=$'\x1f' read -r _model_name _cost_cents _dur_ms _ctx_pct _ctx_exceeds <<< "$_session"
  [[ "$_cost_cents"  =~ ^[0-9]+$ ]] || _cost_cents=0
  [[ "$_dur_ms"      =~ ^[0-9]+$ ]] || _dur_ms=0
  [[ "$_ctx_pct"     =~ ^[0-9]+$ ]] || _ctx_pct=""
  [[ "$_ctx_exceeds" == "1"      ]] || _ctx_exceeds=0
fi

# Derived display bits (empty/0 unless the feature is on AND the data is present).
# The model badge shows whatever Claude Code reports in model.display_name
# (Opus / Sonnet / Haiku / Fable / …) verbatim — no hard-coded family list, so a
# new model surfaces correctly without a code change.
_dur_tag=""
if [[ "$_cfg_duration" != "false" ]] && (( _dur_ms > 0 )); then
  _dur_tm=$(( _dur_ms / 60000 ))
  if (( _dur_tm >= 60 )); then _dur_tag="$(( _dur_tm / 60 ))h$(( _dur_tm % 60 ))m"; else _dur_tag="${_dur_tm}m"; fi
fi
_model_badge=""
[[ "$_cfg_model" != "false" && -n "$_model_name" ]] && _model_badge=$(_sanitize "$_model_name")
_ctx_alarm=0
if [[ "$_cfg_context" != "false" ]]; then
  if [[ -n "$_ctx_pct" ]] && (( _ctx_pct >= 80 )); then _ctx_alarm=1
  elif (( _ctx_exceeds )); then _ctx_alarm=1; fi
fi
_cost_tag=""
if [[ "$_cfg_cost" != "false" ]] && (( _cost_cents > 0 )); then
  _cost_tag=$(printf '$%d.%02d' "$(( _cost_cents / 100 ))" "$(( _cost_cents % 100 ))")
fi

# --- Render ---
_output=""

case "$_render_mode" in

  # ---- MODE 0: sparkle approach (≤30 min before bedtime) ----
  mode0)
    # 4-second sparkle cycle: dim → normal → dim using sine brightness
    _sp_phase=$(( (_ts % 4) * 8 ))  # maps 0-3s into 0,8,16,24 sine steps
    if [[ "$_cfg_breathing" != "false" ]]; then
      _sp_brightness="${_SINE[$_sp_phase]}"
      if (( _sp_brightness < 40 )); then
        _sp_clr="${DIM}${CYAN}"
      elif (( _sp_brightness > 70 )); then
        _sp_clr="${CYAN}${BOLD}"
      else
        _sp_clr="${CYAN}"
      fi
    else
      _sp_clr="${CYAN}"
    fi
    _msg0=$(_pick_message 0 "almost time…")
    _output="${_sp_clr}${_sparkle_glyph}${RST} ${DIM}${_hhmm}${RST}  ${DIM}${CYAN}${_msg0}${RST}"
    ;;

  # ---- MODES 1-5: shame escalation ----
  mode1|mode2|mode3|mode4|mode5)
    # Numeric mode for arithmetic
    _vm="${_render_mode#mode}"

    # Color pair for this render (cycle every 3s, 24 pairs)
    IFS=';' read -r _pfg _pbg <<< "${_vibe_pairs[$(( (_ts / 3) % _np ))]}"
    _VFG=$'\033[38;5;'"${_pfg}"'m'
    _VBG=$'\033[48;5;'"${_pbg}"'m'
    (( _no_color )) && { _VFG=""; _VBG=""; }
    _rbase=$(( (_ts / 2) % ${#_vibe_rpal[@]} ))

    # Blink type: mode 1-2 = slow, mode 3-4 = rapid, mode 4 alternates per second (strobe)
    _blink="${BLINK}"
    (( _vm >= 3 )) && _blink="${BLINK2}"
    (( _vm >= 4 && _ts % 2 == 1 )) && _blink="${BLINK}"

    # Wave speed scales with mode (chars/sec)
    case "$_vm" in
      1|2) _wave_speed=3 ;;
      3)   _wave_speed=4 ;;
      4)   _wave_speed=5 ;;
      5)   _wave_speed=6 ;;
      *)   _wave_speed=3 ;;
    esac

    # Time suffix (e.g. "+2h30m")
    _ck_h=$(( _delta_min / 60 )); _ck_m=$(( _delta_min % 60 ))
    if   (( _delta_min < 60  ));            then _ck_suffix=" +${_delta_min}m"
    elif (( _ck_m == 0 ));                  then _ck_suffix=" +${_ck_h}h"
    else                                         _ck_suffix=" +${_ck_h}h${_ck_m}m"; fi

    _clock_text="${_hhmm}${_ck_suffix}${_dur_tag:+ ${_dur_tag}}"

    # Mode 5: apply char decay to clock (glitch effect). Skipped under no-color:
    # decayed █ with no color differentiation is unreadable noise, not a glitch.
    (( _vm >= 5 && ! _no_color )) && _clock_text=$(_apply_decay "$_clock_text")

    # Build rainbow clock (or plain if rainbow disabled)
    if [[ "$_cfg_rainbow" != "false" ]]; then
      _rainbow=$(_build_rainbow "$_clock_text" "$_wave_speed" "$_rbase" "$_blink" "$_vm")
    else
      _rainbow="${BOLD}${_clock_text}${RST}"
    fi

    # Context-window redline: a bright-red [!] marker before the clock when the
    # session is deep into its context window (used_percentage >= 80, or the
    # legacy exceeds_200k flag). A leading token, so it survives the rainbow's
    # per-character resets; a plain [!] under no-color.
    if (( _ctx_alarm )); then
      if (( _no_color )); then
        _rainbow="[!] ${_rainbow}"
      else
        _rainbow=$'\033[1;38;5;196m[!]'"${RST} ${_rainbow}"
      fi
    fi

    # Glyph selection
    if (( _vm >= 5 )); then
      _glyph_pool=("${_doom_glyphs[@]}")
    else
      _glyph_pool=("${_night_glyphs[@]}")
    fi
    _np_g=${#_glyph_pool[@]}
    _vg_idx=$(( (_ts / 5) % _np_g ))
    _glyph="${_glyph_pool[$_vg_idx]}"

    # Mode 5: two additional glyphs (independently rotating) for swarm. Suppressed
    # under no-animation (accessible) so the line stays a single calm glyph.
    if (( _vm >= 5 && ! _no_anim )); then
      _glyph2="${_glyph_pool[$(( ((_ts / 3) + 5) % _np_g ))]}"
      _glyph3="${_glyph_pool[$(( ((_ts / 7) + 10) % _np_g ))]}"
    fi

    # Shame message — a costly session bumps the message tier one step (the pool
    # widens to the harder pool above), while the visual mode stays at _vm.
    _msg_vm="$_vm"
    if [[ "$_cfg_cost" != "false" ]] && (( _cost_cents >= _cfg_cost_bump * 100 && _msg_vm < 5 )); then
      _msg_vm=$(( _msg_vm + 1 ))
    fi
    _vm_text=$(_pick_message "$_msg_vm" "GO TO BED")

    # Matrix drip prefix for mode 3+ (suppressed under no-animation / accessible)
    _drip_prefix=""
    (( _vm >= 3 && ! _no_anim )) && _drip_prefix=$(_drip_char)

    # Shame text block — breathing modulates color at mode 1+ if enabled
    _shame_fg="${_vibe_rpal[$(( (_rbase + 4) % ${#_vibe_rpal[@]} ))]}"
    if [[ "$_cfg_breathing" != "false" ]] && (( _vm >= 1 )); then
      # Breathing shifts the shame fg between rpal entries
      _breath_offset=$(( ${_SINE[$_breath_phase]} * ${#_vibe_rpal[@]} / 100 ))
      _shame_fg="${_vibe_rpal[$(( (_rbase + 4 + _breath_offset) % ${#_vibe_rpal[@]} ))]}"
    fi
    (( _no_color )) && _shame_fg=""

    _shame_ul="";   (( _vm >= 2 )) && _shame_ul="${UNDERLINE}"
    _shame_rev="";  (( _ts % 2 == 1 && _vm >= 4 )) && _shame_rev="${REVERSE}"
    _shame_block="${_shame_rev}${_VBG}${_shame_fg}${BOLD}${_blink}${_shame_ul} ${_drip_prefix}${_vm_text}${_cost_tag:+ ${_cost_tag}} ${RST}"

    # Assemble line based on mode. The mode-5 swarm branch is taken only when the
    # extra glyphs were built (same `_vm >= 5 && ! _no_anim` guard), so accessible
    # mode falls through to the single-glyph line and never references unset vars.
    if (( _vm >= 5 && ! _no_anim )); then
      # Glyph swarm: glyph1 <clock> glyph2<drip+shame>glyph3
      _output="${_blink}${_glyph}${RST} ${_rainbow}  ${_glyph2}${_shame_block}${_glyph3}${RST}"
    else
      _output="${_blink}${_glyph}${RST} ${_rainbow}  ${_shame_block}"
    fi
    ;;

  # ---- MOTIVATION: 07:00-15:59 ----
  motivation)
    _mot_text=$(_pick_message motivation "let's go")
    _output="${DIM}${_sparkle_glyph} ${_hhmm}${RST}  ${CYAN}${_mot_text}${RST}${_model_badge:+  ${DIM}${_model_badge}${RST}}"
    ;;

  # ---- DAWN: 04:00-06:59 ----
  dawn)
    _dawn_text=$(_pick_message dawn "still here?")
    _output="${DIM}${_glyph_dawn} ${_hhmm}${RST}  ${WHITE}${_dawn_text}${RST}${_model_badge:+  ${DIM}${_model_badge}${RST}}"
    ;;

  # ---- PLAIN: no shame, no special context ----
  plain)
    _output="${DIM}${_glyph_moon} ${_hhmm}${RST}${_model_badge:+  ${DIM}${_model_badge}${RST}}"
    ;;

esac

printf '%s\n' "$_output"

# --- Composition (--after=CMD): cc-insomnii line is rendered FIRST (always at
# the top), then CMD's output is piped through and printed below. Failures
# in CMD are silenced so cc-insomnii's line stays clean even if the wrapped
# tool breaks. The wrapped output always gets exactly one trailing newline:
# $() strips any it produced, so a single printf '%s\n' re-adds one and keeps
# the layout tidy regardless of how CMD terminated its output.
if [[ -n "$WRAP_AFTER" ]]; then
  _wrapped_out=$(printf '%s' "$_json" | eval "$WRAP_AFTER" 2>/dev/null) || true
  # Keep this an `if` (not `[[ … ]] && printf`): when the wrapped command yields
  # no output this is the script's final statement, and a short-circuited && list
  # would make cc-insomnii exit non-zero despite having printed its own line.
  if [[ -n "$_wrapped_out" ]]; then
    printf '%s\n' "$_wrapped_out"
  fi
fi
